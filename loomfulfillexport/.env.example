# Lấy từ Partner Dashboard (dev.shopify.com) > App > Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# URL public của service trên Railway (KHÔNG có dấu / ở cuối)
SHOPIFY_APP_URL=https://your-service.up.railway.app

SCOPES=read_orders,read_products

# Railway: bấm "Add variable reference" -> Postgres -> DATABASE_URL
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Tên line item property dùng làm cột "Url Mockup" (nhiều tên cách nhau bằng dấu phẩy)
MOCKUP_PROPERTY_KEYS=Custom Design Image

NODE_ENV=production
PORT=3000
